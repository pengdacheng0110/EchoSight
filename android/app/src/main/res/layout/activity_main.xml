<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_bg">

    <!--
      相机预览：fitCenter 居中，OverlayView 用同一套映射规则画框。
      四周留白由根布局的深色画布底兜住，浅色主题下也不会出现白边。
    -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <!-- 顶部渐暗，垫在状态卡片与方位条下面 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <com.echosight.app.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部信息区：状态卡片（状态点 + 图标 + 主副标题）+ 方位条 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/status_card_bg"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/status_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="@color/state_idle" />

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_visibility"
                    app:tint="@color/state_idle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_starting"
                        android:textColor="@color/status_card_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statusSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/sub_no_target"
                        android:textColor="@color/status_card_sub"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 方位条：目标相对正前方的水平角，没有目标时隐藏 -->
        <com.echosight.app.BearingView
            android:id="@+id/bearingView"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 底部渐暗，让按钮更清楚 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!--
      主按钮：点一下开始说话，再点一下表示说完了（说完静音一会儿也会自动结束）。

      做成接近全宽的横条，而不是原先那个居中 132dp 的圆点：
      盲人用户靠摸来定位，一个圆点只有指尖那么大，而"屏幕底部横着一条"
      几乎不可能摸错 —— 摸到屏幕下缘往上一寸就是它。

      高度 104dp、圆角 30dp，都留得比常规按钮厚：手感上更容易确认按到了。
      另外加了一圈浅色描边，因为按钮压在相机预览上，遇到浅色背景
      （白墙、雪地）光靠填充色边界会糊掉。
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/pushButton"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="36dp"
        android:contentDescription="@string/btn_talk_desc"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_talk"
        android:textColor="@color/white"
        android:textSize="21sp"
        app:backgroundTint="@color/mic_button"
        app:cornerRadius="30dp"
        app:elevation="10dp"
        app:icon="@drawable/ic_mic"
        app:iconGravity="textTop"
        app:iconPadding="6dp"
        app:iconSize="34dp"
        app:iconTint="@color/white"
        app:strokeColor="@color/mic_button_stroke"
        app:strokeWidth="2dp" />

</FrameLayout>
