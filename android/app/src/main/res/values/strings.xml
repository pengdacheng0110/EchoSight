    <!--
      主按钮文案。
      不再是"按住说话"：现在点一下开始、说完静音一会儿自动结束，
      所以按钮上不该出现"按住"两个字 —— 写着不存在的操作方式比不写更糟。
    -->
    <string name="btn_talk">点一下说话</string>
    <string name="btn_talk_listening">正在听…</string>
    <string name="btn_talk_desc">点一下开始说话，再点一下表示说完了</string>

