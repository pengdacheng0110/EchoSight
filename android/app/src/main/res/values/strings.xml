<resources>
    <string name="app_name">回声视见</string>

    <!-- 状态卡片 -->
    <string name="status_starting">正在启动…</string>
    <string name="status_need_permission">需要相机和麦克风权限才能使用，点这里重新授权</string>
    <string name="status_no_key">未配置语音接口 Key，语音功能不可用</string>
    <string name="status_mic_busy">无法开始录音，请检查是否有其他应用正在占用麦克风</string>
    <string name="status_frame_error">画面处理出错，正在重试…</string>
    <!--
      识别请求本身失败（网络不通 / Key 过期 / 服务限流）。
      和"没听清"必须分开写：那句话是在说用户没说好，这句是在说服务连不上。
      混在一起会让盲人用户一遍遍提高音量重试，而真正该做的是去看网络。
    -->
    <string name="status_asr_failed">连不上语音识别服务，请检查手机网络</string>

    <!-- 状态副标题 -->
    <string name="sub_no_target">尚未选择目标物品</string>
