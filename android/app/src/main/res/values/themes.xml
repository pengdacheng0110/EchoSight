<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EchoSight" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 冷启动窗口用深色画布底，避免启动瞬间闪一下白屏 -->
        <item name="android:windowBackground">@color/canvas_bg</item>

        <!-- 相机取景界面固定深色，状态栏 / 导航栏都用浅色图标 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/canvas_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
